PORT=3000
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000
JWT_SECRET=change-me
# optional: system Tesseract for faster image OCR (tesseract.js is used otherwise)
TESSERACT_BIN=C:\Program Files\Tesseract-OCR\tesseract.exe
